<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Spain Trip</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MuralAppleClientID</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>MuralApplePurchaseEnvironment</key>
	<string>$(MURAL_APPLE_PURCHASE_ENVIRONMENT)</string>
	<key>MuralApplePurchasesEnabled</key>
	<string>$(MURAL_APPLE_PURCHASES_ENABLED)</string>
	<key>MuralAppleSignInEnabled</key>
	<string>$(MURAL_APPLE_SIGN_IN_ENABLED)</string>
	<key>MuralGoogleClientID</key>
	<string>$(MURAL_GOOGLE_CLIENT_ID)</string>
	<key>MuralGoogleSignInEnabled</key>
	<string>$(MURAL_GOOGLE_SIGN_IN_ENABLED)</string>
	<key>MuralManagedAPIURL</key>
	<string>$(MURAL_MANAGED_API_URL)</string>
	<key>MuralManagedAccountsEnabled</key>
	<string>$(MURAL_MANAGED_ACCOUNTS_ENABLED)</string>
	<key>NSCameraUsageDescription</key>
	<string>Spain Trip includes an upstream communication framework that references camera APIs. Travel practice uses the microphone only and does not capture photos or video.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Spain Trip uses the microphone only while you record a practice reply. Recognition runs on this phone; reviewed text is sent only when you tap Send.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Spain Trip turns your spoken Spanish into editable text using on-device speech recognition.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
